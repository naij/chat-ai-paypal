{
  "name": "rosen-chat-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rosen Chat AI \u2014 React interactive demo",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 8080 --strictPort",
    "dev": "vite --host 0.0.0.0 --port 8080 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080 --strictPort",
    "check": "node --check src/chat.js && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:mobile": "node tests/mobile.mjs",
    "test:profile": "node tests/profile.mjs",
    "test:hire": "node tests/hire.mjs",
    "test:boss": "node tests/boss.mjs",
    "test:paypal": "node tests/paypal-payment.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "ag-studio": "^3.0.0",
    "ag-studio-react": "^3.0.0",
    "axios": "^1.20.0",
    "md5": "^2.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "vite": "^7.1.0"
  },
  "license": "MIT"
}
